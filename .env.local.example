# Required — get from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Required — get from https://api.search.brave.com/register
BRAVE_SEARCH_API_KEY=

# Optional — get from https://developer.company-information.service.gov.uk
# Without this key, Companies House requests are rate-limited to 600/min shared
COMPANIES_HOUSE_API_KEY=

# Optional — get from https://firecrawl.dev
# Without this, the scraper falls back to direct HTTP fetching
FIRECRAWL_API_KEY=
